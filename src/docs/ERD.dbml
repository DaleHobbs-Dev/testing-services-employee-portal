Table employees {
  id int [pk, increment]
  name varchar(100) [not null]
  email varchar(100) [unique, not null]
  role varchar(50) [not null, note: 'admin, proctor, scheduler, checkin, frontdesk, technician, clerk']
  status varchar(50) [not null, default: 'active', note: 'active, inactive, restricted']
  phone varchar(20)
  notes text
  employeeCode varchar(20) [unique]
  locationId int [not null, ref: > locations.id]
  badgeColor varchar(20) [unique, note: 'Hex color used to render this employee\'s schedule badges on the calendar']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table certifications {
  id int [pk, increment]
  key varchar(50) [unique, not null]
  label varchar(100) [not null]
}

Table permissions {
  id int [pk, increment]
  key varchar(50) [unique, not null]
  label varchar(100) [not null]
}

Table employeeCertifications {
  employeeId int [not null, ref: > employees.id]
  certificationId int [not null, ref: > certifications.id]
  
  indexes {
    (employeeId, certificationId) [pk]
  }
}

Table employeePermissions {
  employeeId int [not null, ref: > employees.id]
  permissionId int [not null, ref: > permissions.id]
  
  indexes {
    (employeeId, permissionId) [pk]
  }
}

Table testFamilies {
  id int [pk, increment]
  name varchar(100) [not null]
  description text
  allowsMultipleVariants boolean [default: false]
  requiresVariantSelection boolean [default: true]
  active boolean [default: true]
}

Table testVariants {
  id int [pk, increment]
  familyId int [not null, ref: > testFamilies.id]
  title varchar(150) [not null]
  subtest varchar(100) [note: 'For HiSET/Accuplacer']
  facultyName varchar(100) [note: 'For Faculty Tests']
  course varchar(100) [note: 'For Faculty Tests']
  duration int [not null, note: 'Duration in minutes']
  active boolean [default: true]
}

Table workstations {
  id int [pk, increment]
  label varchar(50) [not null]
  room varchar(50) [not null]
  notes text
  locationId int [not null, ref: > locations.id]
}

Table examinees {
  id int [pk, increment]
  firstName varchar(50) [not null]
  lastName varchar(50) [not null]
  email varchar(100) [unique, not null]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table examSchedules {
  id int [pk, increment]
  examineeId int [not null, ref: > examinees.id]
  testFamilyId int [not null, ref: > testFamilies.id]
  testVariantId int [ref: > testVariants.id, note: 'Single variant exams']
  selectedTestVariantIds json [note: 'Multiple variant exams (array of variant IDs)']
  employeeId int [not null, ref: > employees.id, note: 'Proctor']
  locationId int [not null, ref: > locations.id]
  workstationId int [not null, ref: > workstations.id]
  startTime timestamp [not null]
  endTime timestamp [not null]
  room varchar(50)
  status varchar(50) [default: 'scheduled', note: 'scheduled, checked-in, in-progress, completed, cancelled']
  notes text [note: 'DEPRECATED - use notes table instead']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table examScheduleVariants {
  id int [pk, increment]
  examScheduleId int [not null, ref: > examSchedules.id]
  testVariantId int [ref: > testVariants.id]
  sequenceOrder int [not null, note: 'Order subtests are taken']
  status varchar(50) [default: 'scheduled', note: 'scheduled, in-progress, completed, skipped']
  actualStartTime timestamp
  actualEndTime timestamp
  score decimal
  notes text
  
  indexes {
    (examScheduleId, testVariantId) [unique]
  }
}

Table locations {
  id int [pk, increment]
  name varchar(100) [not null]
  code varchar(10) [unique, not null]
  building varchar(100)
  room varchar(50)
  addressLine1 varchar(150)
  addressLine2 varchar(150)
  city varchar(100)
  state varchar(2)
  zip varchar(10)
  phone varchar(20)
  notes text
}

Table employeeSchedules {
  id int [pk, increment]
  employeeId int [unique, not null, ref: > employees.id]
  workDays json [not null, note: 'Array of days: Monday, Tuesday, etc.']
  startTime time
  endTime time
}

Table notes {
  id int [pk, increment]
  examScheduleId int [not null, ref: > examSchedules.id]
  message text [not null]
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp [default: `CURRENT_TIMESTAMP`]
  createdBy int [ref: > employees.id]
  updatedBy int [ref: > employees.id]
  noteTypeId int [note: 'Future: reference to noteTypes table']
  isInternal boolean [default: false, note: 'Internal notes vs student-visible']
  isImportant boolean [default: false]
}

Table irregularities {
  id int [pk, increment]
  // Additional fields will be added later
}

//////////////////////////////////////////////////////////
// Core Ticketing Database for Testing Services (Relational)
//////////////////////////////////////////////////////////

Table tickets {
  id                  int [pk, increment]
  created_at          datetime
  updated_at          datetime
  closed_at           datetime

  // Foreign Keys
  opened_by_staff_id  int [ref: > employees.id]         // Staff who created the ticket
  irregularity_id     int [ref: > irregularities.id, null]      // Optional
  location_id         int [ref: > locations.id, null]           // Campus / test center location
  testing_event_id    int [ref: > examSchedules.id, null]      // Optional link to testing event
  examinee_id         varchar(20)                               // Student / examinee ID (not a FK for now)

  // Ticket metadata
  ticket_type         varchar(50)
  status              varchar(20)                               // Open / Closed / Pending, etc.
  priority            varchar(20)                               // Low / Normal / High / Urgent
  origin_source       varchar(50)                               // Email, phone, form submission, etc.

  // External parties (faculty, vendor, advisor, etc.)
  faculty_name        varchar(100)
  faculty_email       varchar(150)
  external_contact_name  varchar(100)
  external_contact_email varchar(150)

  // Communication Tracking
  initial_comm_type   varchar(50)                                // Email, phone, walk-in, etc.
  original_message    text
  requires_email      boolean
  email_template      varchar(100)
  email_subject       varchar(200)
  email_body          text
  email_recipients    text                                       // Could break out eventually into separate table

  // Exam / Testing-specific fields
  exam_type           varchar(50)
  exam_due_date       date
  exam_returned       boolean
  exam_returned_at    datetime

  // Internal workflow fields
  log_notes           text                                        // Append-only note field
  resolution_summary  text
}

//////////////////////////////////////////////////////////
// Many-to-Many: Tickets <-> Testing_Employees
//////////////////////////////////////////////////////////

Table ticketAssignees {
  id                  int [pk, increment]
  ticket_id           int [ref: > tickets.id]
  staff_id            int [ref: > employees.id]
  assigned_at         datetime
  removed_at          datetime [null]                            // For historical accuracy
}

//////////////////////////////////////////////////////////
// Calendar Manager
//////////////////////////////////////////////////////////

Table calendars {
  id int [pk, increment]
  employeeId int [not null, ref: > employees.id, note: 'Owner of this calendar -- each employee manages their own set of calendars']
  name varchar(100) [not null]
  year int [not null]
  rangeType varchar(30) [not null, note: 'janToMay, juneJuly, augToDec, fullYear, custom']
  startMonth int [not null, note: '1-12']
  endMonth int [not null, note: '1-12']
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]
}


Table calendarMonths {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  year int [not null]
  month int [not null, note: '1-12']

  indexes {
    (calendarId, year, month) [unique]
  }
}

Table holidays {
  id int [pk, increment]
  name varchar(100) [not null]
  month int [not null, note: '1-12']
  day int [not null, note: '1-31']
  year int [note: 'Null = recurring fixed-date holiday (e.g. July 4th), applies every year at month/day. Set = one-off/floating holiday (e.g. Thanksgiving) re-entered each year since it can\'t be expressed as month/day alone']
}

Table calendarClosures {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  locationId int [not null, ref: > locations.id]
  date date [not null]
  holidayId int [ref: > holidays.id, note: 'Set when this closure came from the holiday-selection step at creation; null for a manually added closure']
  reason varchar(150) [note: 'Defaults to the holiday name; editable for manual closures']
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (calendarId, locationId, date) [unique]
  }
}

Table calendarDayLabels {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  locationId int [not null, ref: > locations.id]
  date date [not null]
  label varchar(100) [not null]
  showWhenClosed boolean [default: false, note: 'If true, label still renders alongside a closed badge instead of being suppressed by it']
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (calendarId, locationId, date) [unique]
  }
}

Table calendarTestFamilyBadges {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  locationId int [not null, ref: > locations.id]
  date date [not null]
  testFamilyId int [not null, ref: > testFamilies.id]
  startTime time [not null]
  endTime time [not null]
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]
}

Table calendarEmployeeBadges {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  locationId int [not null, ref: > locations.id]
  date date [not null]
  employeeId int [not null, ref: > employees.id]
  startTime time [note: 'Null when customLabel is set instead of a time block']
  endTime time [note: 'Null when customLabel is set instead of a time block']
  customLabel varchar(50) [note: 'OFF, REQUESTED OFF, or custom text -- used instead of a time block; excluded from the 8th-column hours sum']
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]
}

Table calendarDayNotes {
  id int [pk, increment]
  calendarId int [not null, ref: > calendars.id]
  locationId int [not null, ref: > locations.id]
  date date [not null]
  message text [not null]
  createdAt timestamp [default: `CURRENT_TIMESTAMP`]
  updatedAt timestamp [default: `CURRENT_TIMESTAMP`]
  createdBy int [ref: > employees.id]
  updatedBy int [ref: > employees.id]
}